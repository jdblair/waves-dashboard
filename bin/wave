#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Record bead-waves facts in the current project's beads.

Membership is a `wave-<name>` label on each bead; everything else lives in
bd kv so that no bead's updated_at is bumped:

  wave.<name>.title       free text
  wave.<name>.dispatched  ISO-8601 UTC
  wave.<name>.deployed    ISO-8601 UTC, a space, the trunk sha
  wave.<name>.review.started   ISO-8601 UTC: the reviewer was spawned
  wave.<name>.review.finished  ISO-8601 UTC, then optionally a space and
                          `findings=N fixed=M` (either part may be absent)
  wave.<name>.merge.started    ISO-8601 UTC: committing the wave began
  wave.<name>.merge.completed  ISO-8601 UTC, then optionally a space and
                          the trunk sha
  wave.<name>.model.<id>  model the agent for bead <id> ran on
  wave.<name>.modelsrc.<id>  `chosen` (model passed to the agent) or
                          `inherited` (none passed: the session's model);
                          absent on records from before this key existed
  wave.<name>.tokens.<id>  total tokens the agent(s) for bead <id> spent,
                          an integer (retries summed with --add)

<name> is the label suffix: wave-12 -> 12, wave-k3x -> k3x.

Review and merge are optional phases.  `done` needs its `start`;
`merge start` does not need a review, so a wave can skip review.  Starting
a phase again overwrites its start (with a warning) and clears its end,
so the dashboard shows the phase as running again.

Usage:
  wave plan <name> [--title T] <id>...       label beads, set title
  wave dispatch <name> [--title T] [--at ISO] [<id>...]
                                             label any not yet labelled,
                                             record the dispatch time
  wave deployed <name> [--sha SHA] [--at ISO]
                                             record the deploy (sha defaults
                                             to trunk, else HEAD)
  wave review start <name> [--at ISO]        the reviewer was spawned
  wave review done <name> [--findings N] [--fixed M] [--at ISO]
                                             its fixes are in, suites pass
  wave merge start <name> [--at ISO]         about to commit the wave
  wave merge done <name> [--sha SHA] [--at ISO]
                                             committed (sha defaults to
                                             trunk, else HEAD, else none)
  wave model <name> <id> <model> [--inherited]
                                             record the model a bead's agent used;
                                             --inherited when the Agent call passed
                                             no model, so <model> is the session's
  wave tokens <name> <id> <count> [--add]
                                             record the tokens a bead's agent spent
                                             (the total_tokens of its task
                                             notification); --add sums onto the
                                             recorded count, for a retry or fix round
  wave show [<name>]                         print the recorded facts

Writes stay in the Dolt working set (auto-commit is off by default); commit
and push with `bd dolt commit` / `bd dolt push` as usual.
"""

import argparse
import json
import re
import subprocess
import sys
from datetime import datetime, timezone

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")


def bd(*args, capture=True):
    r = subprocess.run(["bd", *args], capture_output=capture, text=True)
    if r.returncode != 0:
        sys.exit(f"wave: bd {' '.join(args)} failed:\n{r.stderr or r.stdout}")
    return r.stdout


def kv_all():
    return json.loads(bd("kv", "list", "--json") or "{}")


def iso_utc(s=None):
    """Normalise a timestamp (default: now) to ISO-8601 UTC, second precision."""
    if s is None:
        t = datetime.now(timezone.utc)
    else:
        t = datetime.fromisoformat(s.replace("Z", "+00:00"))
        if t.tzinfo is None:
            sys.exit(f"wave: --at needs a zone offset: {s}")
    return t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def label_beads(name, ids):
    """Add wave-<name> to beads that lack it; skip the rest so their
    updated_at is not bumped again."""
    label = f"wave-{name}"
    todo = []
    for i in ids:
        issue = json.loads(bd("show", i, "--json"))
        issue = issue[0] if isinstance(issue, list) else issue
        if label not in (issue.get("labels") or []):
            todo.append(i)
    if todo:
        bd("label", "add", *todo, label)
    return todo


def git_sha(required=True):
    for ref in ("trunk", "HEAD"):
        try:
            r = subprocess.run(["git", "rev-parse", "--short", ref],
                               capture_output=True, text=True)
        except FileNotFoundError:
            break
        if r.returncode == 0:
            return r.stdout.strip()
    if required:
        sys.exit("wave: no git trunk or HEAD here; pass --sha")
    return None


def warn(msg):
    print(f"wave: warning: {msg}", file=sys.stderr)


def check_name(name):
    if name.startswith("wave-"):
        name = name[5:]
    if not NAME_RE.match(name):
        sys.exit(f"wave: bad wave name: {name!r}")
    return name


def cmd_plan(a):
    added = label_beads(a.name, a.ids)
    if a.title:
        bd("kv", "set", f"wave.{a.name}.title", a.title)
    print(f"wave {a.name}: labelled {len(added)} of {len(a.ids)}")


def cmd_dispatch(a):
    added = label_beads(a.name, a.ids) if a.ids else []
    if a.title:
        bd("kv", "set", f"wave.{a.name}.title", a.title)
    at = iso_utc(a.at)
    bd("kv", "set", f"wave.{a.name}.dispatched", at)
    print(f"wave {a.name}: dispatched {at}; labelled {len(added)} of {len(a.ids)}")


def cmd_deployed(a):
    at = iso_utc(a.at)
    sha = a.sha or git_sha()
    bd("kv", "set", f"wave.{a.name}.deployed", f"{at} {sha}")
    print(f"wave {a.name}: deployed {at} at {sha}")


# Phase -> (start key, end key), under wave.<name>.
PHASES = {
    "review": ("review.started", "review.finished"),
    "merge": ("merge.started", "merge.completed"),
}


def phase_start(a, phase):
    start, end = PHASES[phase]
    at = iso_utc(a.at)
    kv = kv_all()
    old = kv.get(f"wave.{a.name}.{start}")
    if old is not None:
        warn(f"wave {a.name}: {phase} already started {old}; overwriting")
    if f"wave.{a.name}.{end}" in kv:
        warn(f"wave {a.name}: clearing {end} {kv[f'wave.{a.name}.{end}']}")
        bd("kv", "clear", f"wave.{a.name}.{end}")
    bd("kv", "set", f"wave.{a.name}.{start}", at)
    return kv, at


def phase_end(a, phase, extra):
    start, end = PHASES[phase]
    kv = kv_all()
    if f"wave.{a.name}.{start}" not in kv:
        sys.exit(f"wave: wave {a.name} has no {start}; "
                 f"run `wave {phase} start {a.name}` first")
    old = kv.get(f"wave.{a.name}.{end}")
    if old is not None:
        warn(f"wave {a.name}: {phase} already {end.split('.')[1]} {old}; overwriting")
    at = iso_utc(a.at)
    began = str(kv[f"wave.{a.name}.{start}"]).split(" ")[0]
    if at < began:  # both written by iso_utc, so they sort as text
        warn(f"wave {a.name}: {end} {at} is before {start} {began}")
    value = " ".join([at, *extra])
    bd("kv", "set", f"wave.{a.name}.{end}", value)
    return value


def cmd_review(a):
    if a.action == "start":
        _, at = phase_start(a, "review")
        print(f"wave {a.name}: review started {at}")
    else:
        extra = [f"{k}={v}" for k, v in (("findings", a.findings), ("fixed", a.fixed))
                 if v is not None]
        value = phase_end(a, "review", extra)
        print(f"wave {a.name}: review finished {value}")


def cmd_merge(a):
    if a.action == "start":
        kv, at = phase_start(a, "merge")
        if (f"wave.{a.name}.review.started" in kv
                and f"wave.{a.name}.review.finished" not in kv):
            warn(f"wave {a.name}: review started but not finished")
        print(f"wave {a.name}: merge started {at}")
    else:
        sha = a.sha or git_sha(required=False)
        value = phase_end(a, "merge", [sha] if sha else [])
        print(f"wave {a.name}: merge completed {value}")


def count(s):
    n = int(s)
    if n < 0:
        raise argparse.ArgumentTypeError(f"must be 0 or more: {s}")
    return n


def cmd_model(a):
    src = "inherited" if a.inherited else "chosen"
    bd("kv", "set", f"wave.{a.name}.model.{a.id}", a.model)
    bd("kv", "set", f"wave.{a.name}.modelsrc.{a.id}", src)
    print(f"wave {a.name}: {a.id} on {a.model} ({src})")


def cmd_tokens(a):
    key = f"wave.{a.name}.tokens.{a.id}"
    n = a.count
    if a.add:
        old = kv_all().get(key)
        try:
            n += int(old or 0)
        except ValueError:
            sys.exit(f"wave: {key} holds {old!r}, not a count; record it again without --add")
    bd("kv", "set", key, str(n))
    print(f"wave {a.name}: {a.id} spent {n} tokens")


def cmd_show(a):
    kv = kv_all()
    rows = {}
    for k, v in kv.items():
        m = re.match(r"^wave\.(.+)\.(title|dispatched|deployed"
                     r"|review\.started|review\.finished"
                     r"|merge\.started|merge\.completed)$", k)
        if m and (a.name is None or m.group(1) == a.name):
            rows.setdefault(m.group(1), {})[m.group(2)] = v
    for name in sorted(rows, key=lambda n: (not n.isdigit(), int(n) if n.isdigit() else 0, n)):
        r = rows[name]
        print(f"wave-{name}\t{r.get('dispatched', '-')}\t{r.get('deployed', '-')}\t{r.get('title', '')}")
        for phase, (start, end) in PHASES.items():
            if start in r or end in r:
                print(f"  {phase}\t{r.get(start, '-')}\t{r.get(end, '-')}")


def main():
    p = argparse.ArgumentParser(prog="wave", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("plan")
    s.add_argument("name", type=check_name)
    s.add_argument("--title")
    s.add_argument("ids", nargs="+")
    s.set_defaults(fn=cmd_plan)

    s = sub.add_parser("dispatch")
    s.add_argument("name", type=check_name)
    s.add_argument("--title")
    s.add_argument("--at")
    s.add_argument("ids", nargs="*")
    s.set_defaults(fn=cmd_dispatch)

    s = sub.add_parser("deployed")
    s.add_argument("name", type=check_name)
    s.add_argument("--sha")
    s.add_argument("--at")
    s.set_defaults(fn=cmd_deployed)

    s = sub.add_parser("review")
    s.set_defaults(fn=cmd_review)
    act = s.add_subparsers(dest="action", required=True)
    t = act.add_parser("start")
    t.add_argument("name", type=check_name)
    t.add_argument("--at")
    t = act.add_parser("done")
    t.add_argument("name", type=check_name)
    t.add_argument("--findings", type=count)
    t.add_argument("--fixed", type=count)
    t.add_argument("--at")

    s = sub.add_parser("merge")
    s.set_defaults(fn=cmd_merge)
    act = s.add_subparsers(dest="action", required=True)
    t = act.add_parser("start")
    t.add_argument("name", type=check_name)
    t.add_argument("--at")
    t = act.add_parser("done")
    t.add_argument("name", type=check_name)
    t.add_argument("--sha")
    t.add_argument("--at")

    s = sub.add_parser("model")
    s.add_argument("name", type=check_name)
    s.add_argument("id")
    s.add_argument("model")
    s.add_argument("--inherited", action="store_true",
                   help="no model was passed to the agent; MODEL is the session's")
    s.set_defaults(fn=cmd_model)

    s = sub.add_parser("tokens")
    s.add_argument("name", type=check_name)
    s.add_argument("id")
    s.add_argument("count", type=count)
    s.add_argument("--add", action="store_true",
                   help="add COUNT to the recorded total instead of replacing it")
    s.set_defaults(fn=cmd_tokens)

    s = sub.add_parser("show")
    s.add_argument("name", nargs="?", type=check_name)
    s.set_defaults(fn=cmd_show)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
